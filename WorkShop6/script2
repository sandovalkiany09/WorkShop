<?php
$temperaturas = array(78, 60, 62, 68, 71, 68, 73, 85, 66, 64, 76, 63, 75, 76, 73, 68, 62, 73, 72, 65, 74, 62, 62, 65, 64, 68, 73, 75, 79, 73);

// Calcular la temperatura promedio
$promedio = array_sum($temperaturas) / count($temperaturas);
echo "La temperatura promedio es: " . round($promedio, 1) . "°<br>";

// Eliminar temperaturas duplicadas y ordenar el array
$temperaturas_unicas = array_unique($temperaturas);
sort($temperaturas_unicas);

// Obtener las cinco temperaturas más bajas y más altas
$temperaturas_bajas = array_slice($temperaturas_unicas, 0, 5);
$temperaturas_altas = array_slice($temperaturas_unicas, -5);

// Mostrar las temperaturas más bajas y más altas
echo "Lista de las 5 temperaturas más bajas: " . implode(", ", $temperaturas_bajas) . "<br>";
echo "Lista de las 5 temperaturas más altas: " . implode(", ", $temperaturas_altas) . "<br>";
?>
